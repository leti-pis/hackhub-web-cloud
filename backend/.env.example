# MySQL (docker-compose)
MYSQL_DATABASE=hackhub
MYSQL_USER=hackhub
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PORT=3306

# Spring Boot datasource
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hackhub
DB_USERNAME=hackhub
DB_PASSWORD=change_me

# Backend HTTP server
SERVER_PORT=8080

# Dati iniziali esclusivamente locali/demo (false per disabilitarli)
APP_DEMO_DATA_ENABLED=true

# JWT
APP_JWT_SECRET=change_me_with_a_long_random_secret_at_least_32_chars
APP_JWT_EXPIRATION_MS=3600000

